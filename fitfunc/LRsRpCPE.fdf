[General Information]
Function Name = LRsRpCPE
Brief Description = Series L and Rs, then Rp parallel to a CPE. Inputs (f, |Z|), outputs (Z'/|Z|, -Z''/|Z|), so an unweighted fit is modulus-weighted.
Function Type = User-Defined
Function Form = Equations
Number Of Parameters = 5
Number Of Independent Variables = 2
Number Of Dependent Variables = 2


[Fitting Parameters]
Naming Method = User-Defined
Names = LuH,Rs,Rp,QpF,alpha
Meanings = series inductance (uH),series resistance (ohm),parallel resistance (ohm),CPE-Q in pF s^(alpha-1),CPE exponent
Initial Values = 50(V),2000(V),3000(V),1000(V),0.9(V)
Lower Bounds = 0.01(X,ON),0.01(X,ON),0.1(X,ON),0.001(X,ON),0.4(X,ON)
Upper Bounds = 100000(X,ON),1E6(X,ON),1E8(X,ON),1E8(X,ON),1(X,ON)


[Independent Variables]
f =
zm =


[Dependent Variables]
yr =
yi =


[Formula]
w=2*pi*f;
c=alpha*pi/2;
q=QpF*1e-12;
qw=q*w^alpha;
A=qw*cos(c);
B=qw*sin(c);
inv=1/Rp;
den=(inv+A)^2+B^2;
zr=Rs+(inv+A)/den;
zi=B/den-w*LuH*1e-6;
yr=zr/zm;
yi=zi/zm;


