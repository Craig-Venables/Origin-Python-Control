[General Information]
Function Name = RsRpCPE
Brief Description = Rs in series with Rp parallel to a CPE. Two inputs (f, |Z|) and two outputs (Z'/|Z|, -Z''/|Z|) so an unweighted fit is modulus-weighted.
Function Type = User-Defined
Function Form = Equations
Number Of Parameters = 4
Number Of Independent Variables = 2
Number Of Dependent Variables = 2


[Fitting Parameters]
Naming Method = User-Defined
Names = Rs,Rp,QpF,alpha
Meanings = series resistance (ohm),parallel resistance (ohm),CPE-Q in pF s^(alpha-1),CPE exponent
Initial Values = 8000(V),2.5E7(V),20(V),0.95(V)
Lower Bounds = 1(X,ON),1(X,ON),0.001(X,ON),0.4(X,ON)
Upper Bounds = 1E6(X,ON),1E9(X,ON),100000(X,ON),1(X,ON)


[Independent Variables]
f =
zm =


[Dependent Variables]
yr =
yi =


[Formula]
w=2*pi*f;
c=alpha*pi/2;
q=QpF*1e-12;
qw=q*w^alpha;
A=qw*cos(c);
B=qw*sin(c);
inv=1/Rp;
den=(inv+A)^2+B^2;
zr=Rs+(inv+A)/den;
zi=B/den;
yr=zr/zm;
yi=zi/zm;


